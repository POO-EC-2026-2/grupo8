<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufg.atlas.controllers.GerenteController">
   <top>
      <Label text="GERENCIAMENTO DE MESAS" BorderPane.alignment="CENTER" />
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <HBox fx:id="hbIndicadores" alignment="CENTER_LEFT" prefHeight="90.0" prefWidth="200.0" spacing="16.0">
               <padding>
                  <Insets top="8.0" />
               </padding>
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label fx:id="totalMesas" text="--" />
                        <Label text="Total de mesas" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label fx:id="mesasLivres" text="--" />
                        <Label text="Livres" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label fx:id="mesasOcupadas" text="--" />
                        <Label text="Ocupadas" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label text="--" />
                        <Label text="Pré-conta" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox fx:id="hbFiltros" alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0" spacing="12.0">
               <padding>
                  <Insets top="8.0" />
               </padding>
               <children>
                  <TextField fx:id="campoNumeroMesa" onAction="#buscarMesa" text="Digite o número da mesa" />
                  <ComboBox fx:id="comboEstados" onAction="#filtrarPorEstado" prefWidth="150.0" promptText="Estados" />
                  <ComboBox prefWidth="150.0" promptText="Localização" />
                  <Button mnemonicParsing="false" onAction="#limparFiltros" text="Limpar" />
               </children>
            </HBox>
            <TableView fx:id="tabelaMesas" prefHeight="298.0" prefWidth="600.0">
              <columns>
                <TableColumn fx:id="colunaNumero" prefWidth="75.0" text="Número" />
                <TableColumn fx:id="colunaLocalizacao" prefWidth="75.0" text="Localização" />
                  <TableColumn fx:id="colunaEstado" prefWidth="75.0" text="Estado" />
                  <TableColumn fx:id="colunaGarcom" prefWidth="75.0" text="Garçom" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="56.0" prefWidth="600.0" spacing="40.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#adicionarMesa" text="Adicionar mesa" />
            <Button mnemonicParsing="false" text="Retirar mesa" />
            <Button mnemonicParsing="false" text="Consultar comandas" />
         </children>
         <BorderPane.margin>
            <Insets top="10.0" />
         </BorderPane.margin>
      </HBox>
   </bottom>
</BorderPane>
